f := func() {
    if in_address {
        m := in_address
        speedlimit := 2000000
        brook := import("brook")
        if m.ipaddress {
            r := brook.splithostport(m.ipaddress)
            s := brook.country(r.host)
            if s == "ZZ" {
                return { block: true }
            }
            return { speedlimit: speedlimit }
        }
        if m.domainaddress {
            r := brook.splithostport(m.domainaddress)
            text := import("text")
            if r.host == "localhost" || text.contains(r.host, "speed") || match_block(r.host) {
                return { block: true }
            }
            return { speedlimit: speedlimit }
        }
        return
    }
}
out := f()

match_domain := func(m, domain){
    text := import("text")
    ss := text.split(text.to_lower(domain), ".")
    s := ""
    for i := len(ss) - 1; i >= 0; i-- {
        if s == "" {
            s = ss[i]
        } else {
            s = ss[i] + "." + s
        }
        if m[s] {
            return true
        }
    }
    return false
}

